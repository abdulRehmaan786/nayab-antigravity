datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  password         String
  role             String   // "ADMIN" | "TEACHER"
  assignedClasses  String?  // JSON string: ["Class 8", "Class 9", "Class 10"]
  assignedSubjects String?  // JSON string: [{"className": "Class 9", "subject": "General Science"}, ...]
  classTeacherOf   String?  // e.g. "Class 9" (designated Class Teacher)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Student {
  id          String             @id @default(uuid())
  rollNumber  String             // e.g. "101"
  grNumber    String?            @unique
  name        String
  fatherName  String
  className   String             // e.g. "Class 8", "Class 9", "Class 10"
  section     String             @default("A")
  gender      String             // "Male" | "Female"
  phone       String?
  dateOfBirth String?
  address     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  results     ExamResult[]
  fees        FeeRecord[]
  attendances AttendanceRecord[]

  @@unique([className, rollNumber])
}

model ExamResult {
  id            String   @id @default(uuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examTerm      String   // e.g. "Midterm Examination 2025"
  academicYear  String   @default("2024-2025")
  subjectMarks  String   // JSON string: [{"subject":"English","maxMarks":100,"obtainedMarks":88,"grade":"A+","remarks":"Outstanding"}]
  totalMarks    Float
  obtainedMarks Float
  percentage    Float
  overallGrade  String   // "A+", "A", "B", "C", "F"
  status        String   // "PASS" | "FAIL"
  remarks       String?
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FeeRecord {
  id            String   @id @default(uuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month         String   // e.g. "September 2025"
  amount        Float
  dueDate       String
  status        String   // "PAID" | "PENDING" | "UNPAID"
  paidDate      String?
  receiptNumber String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AttendanceRecord {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date        String   // e.g. "2025-09-10" (YYYY-MM-DD)
  status      String   // "PRESENT" | "LATE" | "ABSENT" | "LEAVE"
  checkInTime String?  // e.g. "07:52 AM"
  deviceType  String   @default("BIOMETRIC_FINGERPRINT") // "BIOMETRIC_FINGERPRINT" | "RFID_CARD" | "MANUAL"
  deviceId    String?  @default("BIO-GATE-01")
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, date])
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  category    String   // "NOTICE" | "EVENT" | "HOLIDAY" | "EXAM"
  isPinned    Boolean  @default(false)
  publishedBy String   @default("Administration")
  date        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StaffMember {
  id             String           @id @default(uuid())
  name           String
  role           String           // "TEACHER" | "SAFAI_WALA" | "SECURITY_GUARD" | "PEON" | "CLERK" | "LAB_ASSISTANT"
  designation    String           // e.g. "Senior Science Teacher", "Campus Cleaner"
  phone          String?
  cnic           String?
  monthlySalary  Float            @default(15000)
  userId         String?          // Links to User if this is a teacher
  status         String           @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "ON_LEAVE"
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  
  attendances    StaffAttendance[]
  salaries       StaffSalary[]
}

model StaffAttendance {
  id          String      @id @default(uuid())
  staffId     String
  staff       StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date        String      // "YYYY-MM-DD"
  status      String      // "PRESENT" | "LATE" | "ABSENT" | "LEAVE"
  checkInTime String?     // e.g. "07:52 AM"
  remarks     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([staffId, date])
}

model StaffSalary {
  id            String      @id @default(uuid())
  staffId       String
  staff         StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month         String      // e.g. "September 2025"
  basicSalary   Float
  allowances    Float       @default(0)
  deductions    Float       @default(0)
  netSalary     Float
  status        String      // "PAID" | "PENDING" | "UNPAID"
  paidDate      String?
  paymentMethod String?     // "CASH" | "BANK" | "EASYPAISA" | "RAAST"
  receiptNumber String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([staffId, month])
}

model GalleryItem {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String
  category    String   @default("CAMPUS") // "CAMPUS" | "SPORTS" | "EVENTS" | "ACADEMICS" | "CEREMONY"
  date        String?  // e.g. "September 2025"
  featured    Boolean  @default(false)
  uploadedBy  String   @default("Admin")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
